RIOT_API_KEY=
RIOT_ID=Nombre#TAG
PLATFORM=la1
REGION=americas
# Opcional: para el analisis de video (proximamente)
GEMINI_API_KEY=
# Opcional: tu clan (pagina Composiciones). Los jugadores cuyo nombre empieza con este prefijo
# (o que registraste en Jugadores) cuentan como del clan. Por defecto: Epsilon
CLAN_PREFIX=Epsilon
# Opcional: varias cuentas de una misma persona, como Cuenta=Persona separadas por ;
# Ejemplo: CLAN_ALIASES='Cuenta Alterna=Jugador Principal'
CLAN_ALIASES=
